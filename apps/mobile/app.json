{
  "expo": {
    "name": "ordio",
    "slug": "ordio",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85c986f9-13ec-46ae-8771-d73a1c30faef",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/logo.png",
    "scheme": "ordio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tech.dogix.ordio",
      "icon": "./assets/images/logo.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Ordio usa Bluetooth para imprimir tickets en la impresora de la caja.",
        "NSBluetoothPeripheralUsageDescription": "Ordio usa Bluetooth para imprimir tickets en la impresora de la caja."
      }
    },
    "android": {
      "package": "tech.dogix.ordio",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F15A29",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F15A29",
          "image": "./assets/images/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-updates",
      [
        "react-native-thermal-printer-driver",
        {
          "bluetoothAlwaysUsageDescription": "Ordio usa Bluetooth para imprimir tickets en la impresora de la caja.",
          "bluetoothPeripheralUsageDescription": "Ordio usa Bluetooth para imprimir tickets en la impresora de la caja."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85c986f9-13ec-46ae-8771-d73a1c30faef"
      }
    }
  }
}
